msgstr "PHP max execution time: %s"

msgid "PHP 版本"
msgstr "PHP version"

msgid "R2 Access Key ID，默认掩码显示。"
msgstr "R2 Access Key ID. Masked by default."

msgid "R2 Secret Access Key，加密保存。"
msgstr "R2 Secret Access Key. Stored encrypted."

msgid "R2 填 us-east-1 或 auto。自定义 S3 按厂商文档填写。"
msgstr "For R2 use us-east-1 or auto. For custom S3 follow the vendor docs."

msgid "RAM AccessKey ID，默认掩码显示。"
msgstr "RAM AccessKey ID. Masked by default."

msgid "RAM AccessKey Secret，加密保存。"
msgstr "RAM AccessKey Secret. Stored encrypted."

msgid "RAM 授权 OSS 读写后，复制 AccessKey ID 与 Secret。"
msgstr "After granting the RAM user OSS read/write, copy the AccessKey ID and Secret."

msgid "REST API 给区块编辑器和第三方用。本项默认关。打开后只拦未登录访客访问 /wp-json/，已登录后台写文章不受影响。不会关掉整个 REST，站点不会因此白屏。前台表单若要用接口，把路径写进排除。"
msgstr "REST API is used by the block editor and third-party apps. This option is off by default. When on, it only blocks unauthenticated visitors from /wp-json/. Logged-in editors in the admin are unaffected. It does not disable REST entirely, so the site will not go blank. If a front-end form needs the API, add its path to the exclusions."

msgid "REST 排除（这些接口仍然放行）"
msgstr "REST exclusions (these endpoints stay allowed)"

msgid "Region（区域）"
msgstr "Region"

msgid "S3 桶名，不要带域名。"
msgstr "S3 bucket name. Do not include a domain."

msgid "Secret Access Key，加密保存。"
msgstr "Secret Access Key. Stored encrypted."

msgid "SecretId，默认掩码显示。"
msgstr "SecretId. Masked by default."

msgid "SecretKey（访问密钥）"
msgstr "SecretKey (secret access key)"

msgid "SecretKey，加密保存。"
msgstr "SecretKey. Stored encrypted."

msgid "URL 包含所列片段则不替换。每行一项，例如 .php、preview=。"
msgstr "URLs that contain any listed fragment are not rewritten. One item per line, for example .php or preview=."

msgid "User Agent 是浏览器报给网站的身份，例如手机 Safari。填写：每行一段文字。只要访问者的身份里包含这段，就不给他缓存页。适合「某种 App 内置浏览器显示错乱」时单独排除。 (.*) 表示中间可以是任意内容。普通网站一般不用填。示例：(.*)Mobile(.*)Safari(.*)"
msgstr "User Agent is the identity the browser sends, such as mobile Safari. Enter one fragment per line. If the visitor’s identity contains that fragment, they do not get a cached page. Useful when an in-app browser renders incorrectly. (.*) matches any content in between. Most sites can leave this empty. Example: (.*)Mobile(.*)Safari(.*)"

msgid "WordPress 会在页头加 EditURI。用第三方软件远程发文章时才需要。大部分站点用不上。"
msgstr "WordPress adds EditURI in the page head. You only need it for remote publishing with third-party software. Most sites can skip it."

