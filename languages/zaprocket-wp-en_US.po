msgid "API 域名只用于上传管理，不能当图片地址。必须带 http:// 或 https://，不要带桶名。"
msgstr "The API host is for upload management only, not for image URLs. It must start with http:// or https://, and must not include the bucket name."

msgid "API 域名只用于上传管理；浏览器看图必须走自定义域名。"
msgstr "The API host is for upload management only. Browsers must load images from a custom domain."

msgid "API 域名（上传用）。不要当图片地址。"
msgstr "API host (uploads only). Do not use it as an image URL."

msgid "API 域名（上传用），不要带桶名。"
msgstr "API host (uploads only). Do not include the bucket name."

msgid "APPID 必填。自定义域名未做 CNAME 时，前台无法用加速域名访问。"
msgstr "APPID is required. Without a CNAME on the custom domain, the front end cannot use the acceleration domain."

msgid "Access Key ID，默认掩码显示。"
msgstr "Access Key ID. Masked by default."

msgid "AccessKey 不正确，请核对访问密钥 ID。"
msgstr "AccessKey is incorrect. Check the access key ID."

msgid "AccessKey（访问密钥 ID）"
msgstr "AccessKey (access key ID)"

msgid "Bucket 所在区域，可搜索中文或 Region ID。"
msgstr "Bucket region. Search by Chinese name or Region ID."

msgid "Bucket（存储桶 / 空间名称）"
msgstr "Bucket (bucket / space name)"

msgid "CDN / 懒加载 / 压缩 / 缓存等"
msgstr "CDN / lazy load / minify / cache, etc."

msgid "CDN 地址（加速域名）"
msgstr "CDN URL (accelerator hostname)"

msgid "CDN 排除（这些不换地址）"
msgstr "CDN exclusions (keep original URLs)"

msgid "CDN、预载、懒加载、脚本压缩与延迟。压缩、Delay JS、整页缓存默认关。"
msgstr "CDN, preload, lazy load, script minify and delay. Minify, Delay JS, and page cache stay off by default."

msgid "CDN加速"
msgstr "CDN"

msgid "CSS 压缩（减小 CSS 体积）"
msgstr "Minify CSS (smaller CSS files)"

msgid "CSS 排除（这些文件不压缩）"
msgstr "CSS exclusions (do not minify these files)"

msgid "CSS 文件"
msgstr "CSS files"

msgid "Cloudflare R2"
msgstr "Cloudflare R2"

msgid "Cookie 是网站存在浏览器里的一小段记号，用来记住登录、购物车等。填写：每行一个名称，或名称里的一段文字。只要这次访问带着匹配的 Cookie，就不走缓存，避免「登录后还看到未登录的页面」。名称可在浏览器开发者工具 → 应用/存储 → Cookie 里看到。示例：wordpress_logged_in 。不确定就留空。"
msgstr "A cookie is a small token the site stores in the browser, used to remember logins, carts, and similar state. Enter one name per line, or a fragment of a name. If this visit sends a matching cookie, the page is not served from cache, so a logged-in user does not see a logged-out page. You can find names in browser developer tools → Application/Storage → Cookies. Example: wordpress_logged_in. Leave empty if you are unsure."

msgid "ECharts 加载失败"
msgstr "Failed to load ECharts"

msgid "Endpoint 不要带桶名。未绑定自定义域时不会改写前台地址。"
msgstr "Do not put the bucket name in the Endpoint. Front-end URLs are not rewritten until a custom domain is bound."

msgid "Endpoint 必须以 http:// 或 https:// 开头。"
msgstr "Endpoint must start with http:// or https://."

msgid "Endpoint 是 API 地址，不要当作图片域名。"
msgstr "Endpoint is an API URL. Do not use it as an image domain."

msgid "Endpoint 是 API 地址，只用于上传。图片公网必须用已绑定的自定义域，不能用 r2.cloudflarestorage.com。"
msgstr "Endpoint is an API URL for uploads only. Public image URLs must use a bound custom domain, not r2.cloudflarestorage.com."

msgid "Endpoint（API 接口地址，仅上传）"
msgstr "Endpoint (API URL, uploads only)"

msgid "Gravatar（评论头像来源）"
msgstr "Gravatar (comment avatar source)"

msgid "HTTPS 证书校验失败。请检查服务器 CA 证书与接口地址。"
msgstr "HTTPS certificate verification failed. Check the server CA bundle and the API URL."

msgid "Heartbeat（后台定时刷新）"
msgstr "Heartbeat (admin polling)"

msgid "JS 压缩（减小 JS 体积）"
msgstr "Minify JS (smaller JS files)"

msgid "JS 延迟加载（点一下或滚动后再跑）"
msgstr "Delay JS (run after a click or scroll)"

msgid "JS 异步加载（页面先出来再跑脚本）"
msgstr "Async JS (render the page first, then run scripts)"

msgid "JS 排除（这些文件不压缩、不合并）"
msgstr "JS exclusions (do not minify or combine these files)"

msgid "JavaScript 文件"
msgstr "JavaScript files"

msgid "MD5 哈希文件名"
msgstr "MD5 hashed file name"

